# Public website URL, without a trailing slash. Add only after a real deployment URL exists.
VITE_SITE_URL=

# Blank contact email uses the confirmed default in src/config/site.ts.
VITE_CONTACT_EMAIL=
VITE_BUDGET_CURRENCY=INR

# These VITE_ values are visible in browser code. Never put passwords or private secrets here.
# The EmailJS public key is for browser use; configure allowed origins and abuse protections.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
